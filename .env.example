# Environment defaults for MiniMax-Music3-WebUI.
# Shared-file ownership (project_contract §9): created in S1; extended in S3 (artifacts); finalised in S7.
# Usage:  cp .env.example .env   # adjust for your host, then
#         docker compose -f deploy/docker-compose.yml up -d
#
# This file defines EXACTLY the MUSIC3_-prefixed variables the compose file substitutes from the
# environment. Every active variable below appears in README.md and is read by deploy/docker-compose.yml,
# and no other — the two-way agreement S7 check C7-6 enforces. Container-internal settings (the artifacts
# TARGET path, the lifecycle knobs, the engine URL) are fixed literals inside the compose file, not host
# .env knobs, and so are not listed here as active variables.

# ============================================================================================
#  STALE BIND-MOUNT WARNING (R-11)
#  MUSIC3_WEIGHTS_DIR MUST point at the real MiniMax-Music3 weights directory ON THIS HOST.
#  Docker bind-mounts a wrong/missing path WITHOUT erroring: the sglang container then starts but
#  the engine fails to load the model (or serves nothing). Verify the path exists and contains
#  modular_model_index.json before `docker compose -f deploy/docker-compose.yml up`.
# ============================================================================================

# Host directory of the MiniMax-Music3 weights. Bind-mounted READ-ONLY to /models/MiniMax-Music3 (INV-2).
MUSIC3_WEIGHTS_DIR=/data/models/MiniMax-Music3

# ============================================================================================
#  ARTIFACTS (S3). Every generation writes one audio file + one sidecar JSON under the artifacts root;
#  the app serves and lists them traversal-safely (INV-8, INV-9). No database, and deliberately NO TTL
#  reaper — a documented divergence from the cloud spec's 24-hour URL expiry (D6). Retention is manual.
#
#  STALE BIND-MOUNT WARNING (R-11): MUSIC3_ARTIFACTS_HOST_DIR MUST be a real, writable host directory.
#  Docker bind-mounts a wrong/missing path WITHOUT erroring; the app then fails fast at startup naming the
#  resolved path rather than silently writing nowhere. Verify the host path exists first.
# ============================================================================================

# HOST directory bind-mounted READ-WRITE onto the container artifacts root (/srv/artifacts). This is where
# the files actually live on disk; prune/back up manually as root — the app writes them as root (no reaper).
MUSIC3_ARTIFACTS_HOST_DIR=/data/minimax-music3/artifacts

# ============================================================================================
#  NETWORK — UNAUTHENTICATED LAN EXPOSURE (R-09, owner decision D5)
#  The app is LAN-reachable and has NO authentication. The default binds ALL interfaces (0.0.0.0) so the
#  GATE-S7 demonstration can reach the WebUI from another machine on the LAN. Narrow to 127.0.0.1 to
#  restrict to this host only — no code change needed. At startup the app logs its bind address and an
#  explicit unauthenticated statement (INV-13); README.md repeats the warning.
# ============================================================================================

# App bind address = host interface the app port is published on. 0.0.0.0 = LAN-reachable; 127.0.0.1 = loopback.
MUSIC3_BIND_ADDR=0.0.0.0

# App HTTP port published on MUSIC3_BIND_ADDR (the container always listens on 8080 internally).
MUSIC3_APP_PORT=8080

# ── Optional app overrides (NOT read by compose; documented for an advanced / non-container run) ─────────
# Sidecar provenance (INV-9); the pinned image otherwise supplies these. Defaults when unset: version
# "unpinned-dev", image digest null, model path null.
#MUSIC3_ENGINE_VERSION=unpinned-dev
#MUSIC3_IMAGE_DIGEST=
#MUSIC3_MODEL_PATH=/models/MiniMax-Music3
# In-container artifacts root (the mount TARGET). Fixed to /srv/artifacts by the compose file; set this
# only for a non-container run pointing at a real writable host directory (unset there disables persistence).
#MUSIC3_ARTIFACTS_DIR=/srv/artifacts
